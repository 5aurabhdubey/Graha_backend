# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini          # good cost/quality balance for chat; upgrade to gpt-4o if you want richer replies

# --- Prokerala Astrology API ---
# Get these from https://api.prokerala.com after creating a client (OAuth2 client-credentials flow)
PROKERALA_CLIENT_ID=your_client_id
PROKERALA_CLIENT_SECRET=your_client_secret
PROKERALA_BASE_URL=https://api.prokerala.com

# --- Server ---
PORT=8080
ALLOWED_ORIGIN=*                   # lock this down to your app's domain / bundle id in production

# --- Rate limiting (protects your OpenAI + Prokerala spend) ---
CHAT_RATE_LIMIT_PER_15MIN=20

# --- Environment ---
NODE_ENV=development                # set to "production" on real deploys

# --- Shared cache (Redis) ---
# Leave unset for local dev (falls back to in-memory automatically).
# REQUIRED once you run more than one instance (docker-compose sets this
# for you automatically — see docker-compose.yml).
# REDIS_URL=redis://localhost:6379

# --- Concurrency caps (protects against rate-limit errors under load) ---
MAX_CONCURRENT_AI_CALLS=10
MAX_CONCURRENT_PROKERALA_CALLS=15
